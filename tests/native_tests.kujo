test_setup { from src.openai import create_client, client_responses, parse_stream }
test "client validates HTTPS and auth" { c:=create_client({"api_key":"secret","transport":func(url,o) { assert_equal(o["_headers"]["Authorization"],"Bearer secret"); return Ok({"_status":200,"_body":"{\"ok\":true}"}) }}); assert_true(client_responses(c,{})["ok"]); assert_true(create_client({"base_url":"http://remote.example"})["validation_error"]!="") }
test "SSE parser handles response deltas" { p:=parse_stream(["event: response.output_text.delta\ndata: {\"type\":\"response.output_text.delta\",\"delta\":\"A\"}\n\n","data: {\"type\":\"response.completed\"}\n\n"],""); assert_true(p["ok"]); assert_equal(len(p["events"]),2); assert_false(parse_stream(["data: bad\n\n"],"")["ok"]) }
test "errors redact key" { c:=create_client({"api_key":"secret","transport":func(url,o) { return Ok({"_status":401,"_body":"{\"error\":{\"message\":\"secret denied\"}}"}) }}); r:=client_responses(c,{}); assert_false(r["ok"]); assert_equal(contains(r["message"],"secret"),0) }
