func get(o,k,f) { if type(o)=="dict" && has_key(o,k) { return o[k] }; return f }
func provider_impl(config) { if type(config)!="dict" { config:={} }; return {"name":"openai","base_url":get(config,"base_url","https://api.openai.com/v1"),"default_model":get(config,"model",""),"api_key_env":"OPENAI_API_KEY","capabilities":{"streaming":true,"tool_calls":true,"structured_output":true,"vision":true,"embeddings":true},"driver":driver()} }
func describe(p) { return {"id":"openai-native","protocol":"openai-responses","auth":{"mode":"bearer","allow_anonymous":false},"capabilities":p["capabilities"]} }
func validate(p) { if type(p)!="dict" || get(p,"base_url","")=="" { return {"ok":false,"errors":[{"field":"base_url","message":"OpenAI provider requires a base URL."}]}}; return {"ok":true,"errors":[]} }
func encode_chat(ctx) { o:=ctx["resolved_options"]; input:=[]; for m in ctx["messages"] { input=push(input,{"role":get(m,"role","user"),"content":get(m,"content","")}) }; body:={"model":get(o,"model",get(ctx["provider"],"default_model","")),"input":input,"stream":get(o,"stream",false)}; for k in ["instructions","tools","tool_choice","response_format","reasoning","include","max_output_tokens","temperature"] { if has_key(o,k) { body[k]:=o[k] } }; return {"url":ctx["provider"]["base_url"]+"/responses","method":"POST","headers":{"Authorization":"Bearer "+ctx["credential"],"Content-Type":"application/json"},"protected_headers":["Authorization","Content-Type"],"body":to_json(body),"stream_mode":get(o,"stream",false)} }
func decode_chat(ctx) { d:=ctx["data"]; text:=get(d,"output_text",""); u:=get(d,"usage",{}); input:=get(u,"input_tokens",0); output:=get(u,"output_tokens",0); reason:=get(d,"status","completed"); if reason=="completed" { reason:="stop" }; return {"ok":true,"request_id":get(ctx,"request_id",""),"model":get(d,"model",get(ctx,"fallback_model","")),"output_text":text,"finish_reason":reason,"tool_calls":[],"usage":{"input_tokens":input,"output_tokens":output,"total_tokens":input+output},"raw_provider":d} }
func decode_error(ctx) { d:=ctx["data"]; if type(d)!="dict" || !has_key(d,"error") { return {"ok":false,"matched":false} }; e:=d["error"]; return {"ok":false,"matched":true,"category":"provider","message":get(e,"message","OpenAI request failed"),"provider_code":get(e,"code","openai_error"),"raw_provider":d} }
func decode_stream(ctx) { p:=parse_stream_impl(get(ctx,"chunks",[]),get(ctx,"body_text","")); if !p["ok"] { return p }; text:=""; for e in p["events"] { if get(e,"type","")=="response.output_text.delta" { text:=text+get(e,"delta","") } }; return {"ok":true,"output_text":text,"finish_reason":"stop","usage":{"input_tokens":0,"output_tokens":0,"total_tokens":0},"raw_provider":{"stream_events":p["events"]}} }
func driver() { return {"contract":"ai-sdk-provider-driver","version":"1.0.0","id":"openai-native","describe":describe,"validate":validate,"encode_chat":encode_chat,"decode_chat":decode_chat,"decode_error":decode_error,"decode_stream":decode_stream} }
export openai_provider:=provider_impl
export openai_driver:=driver
