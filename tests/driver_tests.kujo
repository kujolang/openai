test_setup { from src.provider import openai_provider, openai_driver }
test "driver maps Responses request" { p:=openai_provider({"model":"gpt-test"}); d:=openai_driver(); assert_equal(d["version"],"1.0.0"); e:=d["encode_chat"]({"provider":p,"credential":"secret","messages":[{"role":"user","content":"hi"}],"resolved_options":{"model":"gpt-test"}}); assert_equal(contains(e["url"],"/responses"),1); assert_equal(e["headers"]["Authorization"],"Bearer secret") }
test "driver decodes text and usage" { r:=openai_driver()["decode_chat"]({"fallback_model":"m","data":{"model":"m","status":"completed","output_text":"ok","usage":{"input_tokens":4,"output_tokens":2}}}); assert_equal(r["output_text"],"ok"); assert_equal(r["finish_reason"],"stop"); assert_equal(r["usage"]["total_tokens"],6) }
